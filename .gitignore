# ---- data: never commit raw downloads or caches ----
data/raw/
data/cache/
data/processed/networks/       # regenerated by scripts/build_*.py
data/processed/splits/         # regenerated by Person B's d1/splits.py
data/processed/rewired/
*.part

# ---- results that are regenerated or large ----
results/toy/
results/scores/
results/runs/w5/                  # rewiring arm results (re-derived from rewired/ + splits + labels)
results/**/*.gz

# per-gene score dumps (regenerated by scripts/run_stability_dump.py);
# the SHA-256 manifest in results/tables/ is committed instead
results/scores_v40/

# 40-repeat split panel (scripts/build_splits_v40.py); the SHA-256 manifest
# in results/tables/stability_splits_v40_manifest.tsv is committed instead
data/processed/splits_v40/

# the alpha-sensitivity copy of the per-gene atlas (66 MB, two extra alphas);
# the alpha=0.5 atlas and every summary table are committed
results/tables/stability_per_gene_sens.tsv

# ---- python / tools ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- local debug / reproducer logs (not part of the project) ----
scratch/

# ---- local Python environments (kept out of git; A uses conda, B uses uv) ----
.venv*/
venv/
.env
