# ---- data: never commit raw downloads or caches ----
data/raw/
data/cache/
data/papers/
# cited paper PDFs - copyright, local only (fetch with scripts/fetch_papers.py)
data/processed/networks/
# regenerated by scripts/build_*.py
data/processed/splits/
# regenerated by Person B's d1/splits.py
data/processed/rewired/
*.part

# ---- results that are regenerated or large ----
results/scores/
results/runs/w5/
# rewiring arm results (re-derived from rewired/ + splits + labels)
results/**/*.gz

# per-gene score dumps (regenerated by scripts/run_stability_dump.py);
# the SHA-256 manifest in results/tables/ is committed instead
results/scores_v40/

# 40-repeat split panel (scripts/build_splits_v40.py); the SHA-256 manifest
# in results/tables/stability_splits_v40_manifest.tsv is committed instead
data/processed/splits_v40/

# the alpha-sensitivity copy of the per-gene atlas (66 MB, two extra alphas);
# the alpha=0.5 atlas and every summary table are committed
results/tables/stability_per_gene_sens.tsv

# ---- python / tools ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- local debug / reproducer logs (not part of the project) ----
scratch/

# ---- local Python environments (kept out of git; A uses conda, B uses uv) ----
.venv*/
venv/
.env

# ---- archived pre-fix GNN results (superseded by pre-registration amendment 3) ----
results/runs/gnn_courtesy_OLD_BUGGY/

# ---- Zenodo release bundles (build artefacts; upload to Zenodo directly) ----
release/

# ---- per-gene score dumps (derived data; regenerate in ~5 min with --scores-dir) ----
results/scores_v40/

# ---- control-2 resampling artefacts (derived; regenerate with run_a5.py) ----
results/runs/a5_v40_partial/
results/runs/a5_10rep_validated/
results/runs/a5_ORIGINAL_10rep_backup/
results/tables/*_BEFORE_optimisation.tsv

results/runs/a5/a5/
# control-2 per-arm checkpoint copies (the released copies live one level up)

data/processed/splits_v40_sens8/
# splits for the two STRING sensitivity arms (regenerable, see docs/network_stability.md)
results/scores_shared/
results/scores_v40_cx/
# per-gene score dumps of the complex-aware run (1.1 GB, derived data)
results/runs/*.err
# empty stderr files of the background runs
results/scores_v40_clingen/
# per-gene score dumps of the ClinGen arm (derived data)
results/scores_v40_cx/
# per-gene score dumps of the complex-aware run (derived data)
results/scores_pubcount_adj_v40/
# per-gene score dumps of the Control-7 arms (derived data)

# ---- local preview renders (regenerate with scripts/markdown_to_docx.py) ----
review/docx_preview/

